# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/comfort_db"

# Authentication & Security
AUTH_SECRET="your-ultra-secure-jwt-secret-min-32-chars"

# Transactional Email (SendGrid / Postmark / Resend)
EMAIL_PROVIDER_KEY="re_sample_apiKey_here"

# Cloud Image / Storage (Cloudinary / S3 / Firebase Storage)
STORAGE_PROVIDER_KEY="storage_api_key_sample"

# Payment Gateways (JazzCash / Easypaisa / Meezan / Stripe)
PAYMENT_PROVIDER_KEY="pk_live_sample_payment_key"

# Google Authentication
GOOGLE_CLIENT_ID="sample_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sample_google_client_secret"

# Analytics & Tracking Pixels
ANALYTICS_ID="G-COMFORT982"
META_PIXEL_ID="19827364528192"

# Customer WhatsApp Support Line (Pakistan format without spaces)
WHATSAPP_NUMBER="+923001234567"
